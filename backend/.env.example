# ==============================================================================
# SchemeShield AI - Backend Environment Configuration Example
# Tagline: "Verify Before You Trust."
# Copy this file to .env and adjust variables as needed for your environment.
# DO NOT COMMIT .env WITH REAL SECRETS TO VERSION CONTROL.
# ==============================================================================

# Project Information
PROJECT_NAME="SchemeShield AI"
PROJECT_TAGLINE="Verify Before You Trust."
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Database Configuration (Zero-cost local SQLite)
DATABASE_URL="sqlite:///./schemeshield.db"

# Security & Authentication (Change SECRET_KEY in production)
SECRET_KEY="insecure-development-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Configuration (JSON array of allowed frontend origins for development)
# Allow local React, Vite, Next.js or any other dev servers
CORS_ORIGINS='["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173","http://localhost:8080"]'

# File Upload Configuration (Pre-configured for future document/image uploads)
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10

# Logging
LOG_LEVEL="INFO"
