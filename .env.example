# SchemeShield AI - Frontend Environment Configuration
# Template file: Copy to .env.local to customize local frontend behavior.

# Backend API Base URL (FastAPI)
# When the separate backend service is deployed or running locally, set this:
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Frontend Mock/Demo Mode (true = offline mock data & simulation, false = live backend API)
VITE_ENABLE_MOCK_SERVICES=true
